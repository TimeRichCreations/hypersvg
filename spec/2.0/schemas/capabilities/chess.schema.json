{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hsvg:2.0:schema:capability:chess",
  "title": "HyperSVG 2.0 capability chess: Chess rules",
  "description": "a logic module (10.7): content calls it with the call action, for example {\"id\": \"legal\", \"call\": \"chess.legalMoves\", \"with\": {\"position\": \"boardText\"}, \"to\": {\"moves\": \"legalMoves\"}}; needs entry chess@0.1.0 | a position is a FEN string of at most 100 characters; a move is a UCI string such as e2e4 or e7e8q | legalMoves(position) returns every legal move, at most 256 (218 is the most in any position), in a fixed order; applyMove(position, move) returns the position after a legal move and faults the transaction for an illegal one; status(position) returns {done, outcome}, outcome being white, black or draw once done and an empty string before | calls are synchronous, pure and deterministic; each export declares a time budget (budgetMs, at most 1000); a malformed position faults the transaction | the module runs only when named in needs with its exact version, its digest is pinned, it is in the host's reviewed lock and it runs in a confined executor (A9.3)",
  "$comment": "Generated by docs/spec-2.0-work/tools/schema/make-schemas.mjs from the spec/2.0 machine files. Do not edit.",
  "x-hsvg-section": "10.7, A9.3",
  "x-hsvg-addon": "A9",
  "x-hsvg-kind": "module",
  "x-hsvg-contract": "module",
  "x-hsvg-core": ">=2.0 <3",
  "x-hsvg-dependsOn": [],
  "x-hsvg-owns": {
    "blockFields": [],
    "actions": [],
    "events": [],
    "channels": [],
    "effectKinds": [],
    "controlKinds": []
  },
  "x-hsvg-humanOnly": [],
  "x-hsvg-grants": [],
  "x-hsvg-fills": {},
  "$defs": {
    "exports:legalMoves": {
      "with": {
        "type": "object",
        "properties": {
          "position": {
            "type": "string",
            "maxLength": 100
          }
        },
        "required": [
          "position"
        ],
        "additionalProperties": false
      },
      "returns": {
        "type": "object",
        "properties": {
          "moves": {
            "type": "array",
            "maxItems": 256,
            "x-hsvg-limit": "legalEntries",
            "items": {
              "type": "string",
              "maxLength": 5
            }
          }
        },
        "required": [
          "moves"
        ],
        "additionalProperties": false
      },
      "budgetMs": 100
    },
    "exports:applyMove": {
      "with": {
        "type": "object",
        "properties": {
          "position": {
            "type": "string",
            "maxLength": 100
          },
          "move": {
            "type": "string",
            "maxLength": 5
          }
        },
        "required": [
          "position",
          "move"
        ],
        "additionalProperties": false
      },
      "returns": {
        "type": "object",
        "properties": {
          "position": {
            "type": "string",
            "maxLength": 100
          }
        },
        "required": [
          "position"
        ],
        "additionalProperties": false
      },
      "budgetMs": 100
    },
    "exports:status": {
      "with": {
        "type": "object",
        "properties": {
          "position": {
            "type": "string",
            "maxLength": 100
          }
        },
        "required": [
          "position"
        ],
        "additionalProperties": false
      },
      "returns": {
        "type": "object",
        "properties": {
          "done": {
            "type": "boolean"
          },
          "outcome": {
            "type": "string",
            "enum": [
              "",
              "white",
              "black",
              "draw"
            ],
            "maxLength": 5
          }
        },
        "required": [
          "done",
          "outcome"
        ],
        "additionalProperties": false
      },
      "budgetMs": 100
    }
  }
}
