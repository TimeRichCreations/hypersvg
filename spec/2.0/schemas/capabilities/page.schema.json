    "calls:point": {
      "description": "the actor points at a target hook, for durationMs if given, else until the block leaves",
      "with": {
        "type": "object",
        "properties": {
          "hook": {
            "type": "string",
            "maxLength": 4096,
            "description": "the hook pointed at: a quoted hook name of addons.page.hooks ('cta'), or 'input:<name>' for a hook input of the block"
          },
          "durationMs": {
            "oneOf": [
              {
                "type": "number",
                "minimum": 1,
                "maximum": 60000
              },
              {
                "type": "string",
                "maxLength": 4096
              }
            ]
          }
        },
        "required": [
          "hook"
        ],
        "additionalProperties": false
      }
    },
    "calls:highlight": {
      "description": "a target hook is highlighted, for durationMs if given, else until the block leaves",
      "with": {
        "type": "object",
        "properties": {
          "hook": {
            "type": "string",
            "maxLength": 4096,
            "description": "the hook highlighted: a quoted hook name of addons.page.hooks ('cta'), or 'input:<name>' for a hook input of the block"
          },
          "durationMs": {
            "oneOf": [
              {
                "type": "number",
                "minimum": 1,
                "maximum": 60000
              },
              {
                "type": "string",
                "maxLength": 4096
              }
            ]
          }
        },
        "required": [
