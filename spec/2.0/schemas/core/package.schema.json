          "$ref": "#/$defs/trust-record"
        }
      },
      "additionalProperties": false,
      "x-hsvg-section": "2.5, A9.3",
      "description": "Defined in 2.5, A9.3."
    },
    "derived-from": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$",
