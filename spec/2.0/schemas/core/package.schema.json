            "pattern": "^\\P{Lu}+$"
          }
        },
        "preset": {
          "enum": [
            "static-banner",
            "animated-ad",
            "interactive-ad",
            "slide-video",
            "interactive-video",
            "data-story",
            "lesson",
            "game",
            "website-mascot",
