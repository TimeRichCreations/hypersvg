    },
    "kits": {
      "type": "object",
      "x-hsvg-section": "10.8",
      "description": "kit id to {version, path}"
    },
    "needs": {
      "type": "array",
      "x-hsvg-section": "10.8, 10.11",
      "description": "the union of all needs; recomputed and checked (E-PACKAGE-DESCRIPTOR)"
    },
