      "additionalProperties": false,
      "x-hsvg-section": "4.10, 4.4",
      "description": "Defined in 4.10, 4.4."
    },
    "trust-record": {
      "type": "object",
      "properties": {
        "provenance": {
          "type": "object",
          "properties": {
            "madeWith": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "madeBy": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^(person|agent):.+$"
              }
            },
            "sources": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "inferred": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "substitutions": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "resource": {
                    "type": "string"
                  },
                  "with": {
                    "type": "string"
                  },
                  "reason": {
                    "type": "string"
                  }
                }
              }
            },
            "upgradedFrom": {
              "type": "object"
            },
            "notes": {
              "type": "string",
              "maxLength": 4000
            }
          },
          "additionalProperties": false
        },
        "review": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "status": {
                "enum": [
                  "draft",
                  "candidate",
                  "accepted",
                  "blocked"
                ]
              },
              "by": {
                "type": "string",
                "pattern": "^(person|agent):.+$"
              },
              "date": {
                "type": "string",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}([T ].*)?$"
              },
              "digest": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              },
              "note": {
                "type": "string",
                "maxLength": 2000
              },
              "of": {
                "type": "string"
              },
              "signature": {
                "type": "object",
                "properties": {
                  "key": {
                    "type": "string"
                  },
                  "alg": {
                    "const": "ed25519"
                  },
                  "value": {
                    "type": "string"
                  }
                },
                "required": [
                  "key",
                  "alg",
                  "value"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "status",
              "by",
              "date",
              "digest"
            ],
            "additionalProperties": false,
            "allOf": [
              {
                "if": {
                  "properties": {
                    "status": {
                      "const": "blocked"
                    }
                  },
                  "required": [
                    "status"
                  ]
                },
                "then": {
                  "required": [
                    "note"
                  ]
                }
              },
              {
                "if": {
                  "properties": {
                    "status": {
                      "const": "accepted"
                    }
                  },
                  "required": [
                    "status"
                  ]
                },
                "then": {
                  "properties": {
                    "by": {
                      "not": {
                        "pattern": "^agent:"
                      },
                      "x-hsvg-code": "E-TRUST-REVIEW"
                    }
                  }
                }
              }
            ]
          }
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "pins": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^([a-z][a-z0-9]*(-[a-z0-9]+)*\\.)?[a-z][a-z0-9]*(-[a-z0-9]+)*@.+$"
          },
          "additionalProperties": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        },
        "signature": {
          "type": "object",
          "properties": {
            "by": {
              "type": "string"
            },
            "key": {
              "type": "string"
            },
            "alg": {
              "const": "ed25519"
            },
            "over": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "value": {
              "type": "string"
            }
