{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hsvg:2.0:schema:core:package",
  "title": "HyperSVG 2.0 package document",
  "description": "One experience with everything it needs.",
  "$comment": "Generated by docs/spec-2.0-work/tools/schema/make-schemas.mjs from the spec/2.0 machine files. Do not edit.",
