{
  "format": "hsvg/2.0",
  "registry": "capabilities",
  "description": "Every capability and module name HyperSVG 2.0 knows, the grammar each owns and its authoring-only marks (A10.2, 10.7). Host profiles and capability manifests are checked against it.",
  "notation": "Names are exactly as written in content. <x> is a placeholder. A bracket qualifies a name: seats[kind=player] is the seats map entry whose kind is player; a.*.b is a key b under any entry of a; a[].b is a key b under every list entry of a.",
  "contracts": {
    "section": "10.7, 10.11",
    "note": "Each capability entry carries contract, one of module, privileged or engine.",
    "module": "content-named pure code: typed inputs and outputs, no host ports; named in needs with its exact version and pinned by digest (A9.3)",
    "privileged": "reviewed host code given host ports (page, storage, audio output, network, timers) that the engine checks against the experience's grants; named in needs by name, pinned by the host in its reviewed lock under the manifest version",
    "engine": "built into the engine and reviewed with it; no host ports; named in needs by name only"
  },
  "coreEvents": {
    "section": "5.12, 10.4",
    "note": "Events owned by no capability. self is a core signal kind with the hooks visible and hidden; both are granted under signals.",
    "events": [
      "signal:self:visible",
      "signal:self:hidden"
    ]
  },
  "needsForms": [
    "<capability name>",
    "<module>@<version>",
    "font:<family>"
  ],
  "manifestCategories": [
    "experience",
    "scene",
    "shell",
    "valueFields",
    "controlFields",
    "triggers",
    "actions",
    "controls",
    "bindings",
    "events",
    "effectKinds",
    "channels",
    "exports"
  ],
