      "processing instructions (the XML declaration is allowed)",
      "other XML namespaces"
    ],
    "rule": "an attribute that is in none of these lists, the marks or toolData is refused (E-SVG-UNSAFE); styleOnly and styleRootOnly name style properties, not attributes: they count only inside a style attribute (styleRootOnly on the root only)"
  },
  "marks": {
    "data-hsvg-version": {
      "section": "2.10",
      "on": {
        "kinds": [
          "root"
        ],
        "elements": [
          "svg"
        ]
      },
      "value": {
        "type": "enum",
        "values": [
          "2.0"
        ]
      },
      "codes": [
        "E-SVG-ROOT"
      ]
    },
    "data-hsvg-kind": {
      "section": "4.1",
      "on": {
        "kinds": [
          "part",
          "component",
          "screen"
        ],
        "elements": [
          "*"
        ]
      },
      "value": {
        "type": "enum",
        "values": [
          "part",
          "component",
          "screen"
        ]
      },
      "placement": {
        "part": "an element or <g> inside a component or a screen drawing",
        "component": "the top-level <g> of a component drawing, or a <g> in a screen drawing",
        "screen": "the root <svg> of a screen drawing"
      },
      "codes": [
        "E-KIND",
        "W-KIND-MISSING"
      ]
    },
    "data-hsvg-role": {
      "section": "6.3",
      "on": {
        "kinds": [
          "part",
          "component"
        ],
        "elements": [
          "*"
        ]
      },
      "value": {
        "type": "role-words",
        "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*( [a-z][a-z0-9]*(-[a-z0-9]+)*){0,3}$",
        "maxLength": 96,
        "registry": "roles",
        "sides": [
          "left",
          "right",
          "near",
          "far"
        ],
        "keeps": [
          "keep-inside",
          "keep-clear",
          "keep-empty"
        ],
        "keepPairs": [
          "keep-inside keep-clear"
        ],
        "keepOn": "rect",
        "note": "one role word, then a side (left, right as the viewer sees it; near, far); or protected-area words on an unpainted <rect>: keep-inside, keep-clear, keep-empty, or keep-inside with keep-clear; decoration is ornament screen readers skip (D35)"
      },
      "codes": [
        "E-MARK-VALUE",
        "W-ROLE-UNKNOWN"
      ]
    },
    "data-hsvg-label": {
      "section": "6.5",
      "on": {
        "kinds": [
          "part"
        ],
        "elements": [
          "*"
        ]
      },
      "value": {
        "type": "text",
        "minLength": 1,
        "note": "plain text, the part's name for people"
      },
      "codes": [
        "E-MARK-VALUE"
      ]
    },
    "data-hsvg-pivot": {
      "section": "6.2.1",
      "on": {
        "kinds": [
          "part",
          "component"
        ],
        "elements": [
          "*"
        ]
      },
      "value": {
        "type": "point",
        "pattern": "^-?(?:[0-9]+\\.?[0-9]*|\\.[0-9]+) -?(?:[0-9]+\\.?[0-9]*|\\.[0-9]+)$",
        "note": "x y, two finite decimal numbers"
      },
      "codes": [
        "E-MARK-VALUE",
        "E-PIVOT"
      ]
    },
    "data-hsvg-motion": {
      "section": "6.2.1",
      "on": {
        "kinds": [
          "part"
        ],
        "elements": [
          "*"
        ]
      },
      "value": {
        "type": "channel-ranges",
        "separator": "semicolon",
        "atMostOnePerChannel": true,
        "scaleExcludes": [
          "scale-x",
          "scale-y"
        ],
        "channels": {
          "move-x": {
            "forms": [
              "move-x min..max"
            ],
            "unit": "drawing coordinates",
            "contains": 0
          },
          "move-y": {
            "forms": [
              "move-y min..max"
            ],
            "unit": "drawing coordinates",
            "contains": 0
          },
          "rotate": {
            "forms": [
              "rotate min..max",
              "rotate *"
            ],
            "unit": "degrees",
            "contains": 0,
            "needsPivot": true,
            "note": "rotate * turns without limit"
          },
          "lean": {
            "forms": [
              "lean min..max"
            ],
            "unit": "degrees",
            "minimum": -85,
            "maximum": 85,
            "contains": 0,
            "needsPivot": true
          },
          "scale": {
            "forms": [
              "scale min..max"
            ],
            "unit": "factor",
            "contains": 1,
            "needsPivot": true,
            "minimum": 0,
            "note": "covers both axes"
          },
          "scale-x": {
            "forms": [
              "scale-x min..max"
            ],
            "unit": "factor",
            "contains": 1,
            "needsPivot": true,
            "minimum": 0
          },
          "scale-y": {
            "forms": [
              "scale-y min..max"
            ],
            "unit": "factor",
            "contains": 1,
            "needsPivot": true,
            "minimum": 0
          },
          "opacity": {
            "forms": [
              "opacity min..max"
            ],
            "minimum": 0,
            "maximum": 1,
            "contains": "drawn"
          },
          "draw": {
            "forms": [
              "draw min..max"
            ],
            "minimum": 0,
            "maximum": 1,
            "requires": "pathLength=\"1\" on the element, a stroked <path>, <circle>, <ellipse>, <line>, <polyline>, <polygon> or <rect>",
            "note": "the drawn share of the line's length (the binding word draw, 6.8)"
          },
          "line": {
            "forms": [
              "line min..max"
            ],
            "unit": "drawing coordinates",
            "minimum": 0,
            "maximum": 1000,
            "contains": "drawn",
            "note": "the line thickness (stroke-width)"
          },
          "wipe": {
            "forms": [
              "wipe min..max"
            ],
            "minimum": 0,
            "maximum": 1,
            "contains": "drawn",
            "note": "the share of the part shown, from the left (6.7)"
          }
        }
      },
      "codes": [
        "E-MARK-VALUE",
        "E-PIVOT",
        "E-MOTION-RANGE",
        "E-MOVER-TRANSFORM"
      ]
    },
    "data-hsvg-follow": {
      "section": "6.2.1",
      "on": {
        "kinds": [
          "part"
        ],
        "elements": [
          "*"
        ]
      },
      "value": {
        "type": "id",
        "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$",
        "maxLength": 48,
        "note": "the local id of its leader part"
      },
      "codes": [
        "E-MARK-VALUE",
        "E-FOLLOWS"
      ]
    },
    "data-hsvg-color": {
      "section": "6.2.3",
      "on": {
        "kinds": [
          "group",
          "shape",
          "text"
        ],
        "elements": [
          "g",
          "path",
          "rect",
          "circle",
          "ellipse",
          "line",
          "polyline",
          "polygon",
          "text",
          "tspan",
          "use"
        ]
      },
      "value": {
        "type": "color-role",
        "paints": [
          "fill",
          "stroke"
        ],
        "bareMeans": "fill",
        "eachPaintAtMostOnce": true,
        "mixBareAndQualified": false,
        "roles": {
          "core": "colorRoles.core",
          "kit": "any other id-grammar word a kit theme defines"
        },
        "pattern": "^[ \\t\\r\\n]*(?:R|fill:R(?:[ \\t\\r\\n]+stroke:R)?|stroke:R(?:[ \\t\\r\\n]+fill:R)?)[ \\t\\r\\n]*$",
        "patternWhere": {
          "R": "[a-z][a-z0-9]*(?:-[a-z0-9]+)*"
        }
      },
      "codes": [
        "E-COLOR-ROLE",
        "W-COLOR-ROLE-THEME"
      ]
    },
    "data-hsvg-text-style": {
      "section": "6.2.3",
      "on": {
        "kinds": [
          "group",
          "text"
        ],
        "elements": [
          "g",
          "text",
          "tspan"
        ]
      },
      "value": {
        "type": "type-role",
        "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$",
        "maxLength": 48,
        "roles": {
          "core": "typeRoles.core",
          "kit": "any other id-grammar word a kit theme defines"
        },
        "note": "a theme text style for a text (heading, body, caption, or a kit's own, D37); a <g> passes it down"
      },
      "codes": [
        "E-MARK-VALUE",
        "E-THEME-ROLES",
        "W-COLOR-ROLE-THEME"
      ]
    },
    "data-hsvg-slot": {
      "section": "5.10",
      "on": {
        "kinds": [
          "part"
        ],
        "elements": [
          "g",
          "rect"
        ]
      },
      "value": {
        "type": "id",
        "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$",
        "maxLength": 48,
        "unique": "in the drawing",
        "note": "the slot's name; an empty <g> or an unpainted <rect>"
      },
      "codes": [
        "E-PLACE",
        "E-MARK-VALUE"
      ]
    },
    "data-hsvg-fit": {
      "section": "5.10",
      "on": {
        "kinds": [
          "part"
        ],
        "elements": [
          "rect"
        ]
      },
      "value": {
        "type": "enum",
        "values": [
          "",
          "text",
          "items",
          "video"
        ],
        "note": "the box a text stays inside: no value or text; items: a layout plan's box (the layout add-on); video: a video's box. The box may be painted (D38)."
      },
      "codes": [
        "E-PLACE",
        "E-MARK-VALUE"
      ]
    },
    "data-hsvg-repeat": {
      "section": "5.10",
      "on": {
        "kinds": [
          "part"
        ],
        "elements": [
          "g"
        ]
      },
      "value": {
        "type": "text",
        "note": "any value, or none: a group whose child slots hold one item each"
      },
      "codes": [
        "E-PLACE"
      ]
    },
    "data-hsvg-route": {
      "section": "5.10",
      "on": {
        "kinds": [
          "part"
        ],
        "elements": [
          "path",
          "line",
          "polyline"
        ]
      },
      "value": {
        "type": "enum",
        "values": [
          "track",
          "surface"
        ]
      },
      "codes": [
        "E-PLACE",
        "E-MARK-VALUE"
      ]
    },
    "data-hsvg-variant": {
      "section": "6.2.4",
      "on": {
        "kinds": [
          "look-child"
        ],
        "elements": [
          "g"
        ],
        "note": "each look: a direct child <g> of a part with looks"
      },
      "value": {
        "type": "id",
        "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$",
        "maxLength": 48,
        "unique": "in the part",
        "note": "the look name; the rest look is the one shown (no display=\"none\")"
      },
      "codes": [
        "E-LOOK"
      ]
    },
    "data-hsvg-layer": {
      "section": "6.4",
      "on": {
        "kinds": [
          "group",
          "part",
          "component"
        ],
        "elements": [
          "*"
        ]
      },
      "value": {
        "type": "enum",
        "values": [
          "content",
          "backdrop",
          "overlay",
          "decoration"
        ]
      },
      "default": "content",
      "codes": [
        "E-PAINT",
        "E-MARK-VALUE"
      ]
    }
  },
  "markTiers": {
    "section": "6.1",
    "rootSvg": {
      "required": [
