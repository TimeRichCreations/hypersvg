    "core": [
      "heading",
      "body",
      "caption"
    ],
    "kitRoles": "other type roles a kit theme defines (7.7): id grammar, never a core name"
  },
  "clipChannels": {
    "section": "6.7",
    "core": [
      "move",
      "rotate",
      "scale",
      "opacity",
      "color",
      "draw",
