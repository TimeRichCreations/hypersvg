      "ink",
      "accent",
      "accent-2",
      "muted",
      "success",
      "warning",
      "danger"
    ],
    "focus": "accent-2",
    "paints": [
      "fill",
      "stroke"
    ],
    "bareMeans": "fill",
    "kitRoles": "other roles a kit theme defines (7.7): id grammar, never a core name",
    "contrast": {
      "section": "7.7",
      "inkOnSurface": 4.5,
      "mutedOnSurface": 4.5,
      "successOnSurface": 4.5,
      "warningOnSurface": 4.5,
      "dangerOnSurface": 4.5,
      "focusOnSurface": 3,
