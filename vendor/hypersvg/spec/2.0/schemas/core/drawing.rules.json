  "toolRecord": {
    "section": "6.6",
    "element": "metadata",
    "on": "a direct child of the root <svg>; at most one",
    "value": "one JSON object",
    "keys": {
      "derived": {
        "enum": [
          "derived",
          "edited"
        ]
      },
      "steps": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*:[a-z]+(-[a-z]+)*( [a-z][a-z0-9]*(-[a-z0-9]+)*:[a-z]+(-[a-z]+)*)*$",
        "maxLength": 4096,
        "note": "the give-way steps a bake took for this derived frame, in the order taken: <rule id>:<step>, once per time, space-separated; written by the packer"
      },
      "asset": {
        "type": "object",
        "note": "a HyperSVG's record (D45, 2.13, 10.14): format, id, drawing, members and files; written by pack --asset, read by unpack and the asset player, which check it (src/asset.mjs)"
      }
    },
    "codes": [
      "E-MARK-VALUE"
    ]
  },
  "colorRoles": {
    "section": "6.2.3",
    "core": [
