    "code": "E-SVG-LIMIT",
    "overLimit": "refused, never clamped",
    "addresses": "href on <use> and every url(...) is a local #id; href on <image> is a data: URI of an image type or the relative path of a declared image resource; no other scheme",
    "css": {
