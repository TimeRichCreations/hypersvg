{
  "format": "hsvg/2.0",
  "kind": "scene",
  "id": "game",
  "layouts": [
    {
      "id": "wide",
      "shape": "wide",
      "drawing": "game.svg"
    },
    {
      "id": "tall",
      "shape": "tall",
      "drawing": "game.tall.svg"
    }
  ],
  "presets": [
    {
      "use": "example.shake@1.0.0",
      "as": "nope",
      "with": {
        "target": "board",
        "distance": 10
      }
    }
  ],
  "addons": {
    "example.glow": {
      "part": "board",
      "color": "#ffb800",
      "level": "glow"
    }
  },
  "outputs": {
    "changeLevel": {
      "kind": "event"
    }
  },
  "values": {
    "board": {
      "type": "array",
      "maxItems": 9,
      "items": {
        "type": "string",
        "enum": [
          "",
          "X",
          "O"
        ],
        "maxLength": 1
      },
      "initial": [
        "",
        "",
        "",
        "",
        "",
        "",
        "",
        "",
        ""
      ]
    },
    "cell": {
      "type": "number",
      "minimum": 0,
      "maximum": 8,
      "initial": 0
    },
    "winner": {
      "type": "string",
      "enum": [
        "",
        "X",
        "O",
        "draw"
      ],
      "initial": "",
      "maxLength": 4
    },
    "reply": {
      "type": "number",
      "minimum": -1,
      "maximum": 8,
      "initial": -1
    },
    "seed": {
      "type": "number",
      "minimum": 0,
      "maximum": 99999,
      "initial": 17
    },
    "glow": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "initial": 0
    },
    "cheered": {
      "type": "boolean",
      "initial": false
    }
  },
  "computed": {
    "lineRows": "filter(data.lines, at(board, item.a, '') !== '' && at(board, item.a, '') === at(board, item.b, '') && at(board, item.a, '') === at(board, item.c, ''))",
    "winLine": "length(lineRows) > 0 ? at(lineRows, 0, data.lines[0]).id : ''",
    "thinkingNow": "active('thinking') || active('reaching') || active('inking')",
    "reachCell": "(active('reaching') || active('inking')) ? reply : -1",
    "reachAngle": "at([0, -28.1, -46.9, 0, -19.2, -34.9, 0, -14.5, -27.3], reachCell, 28)",
    "reachSlide": "at([101, 122.5, 175.6, 187, 201.5, 241, 273, 283.9, 314.8], reachCell, 60)",
    "mood": "active('over') ? (winner === 'X' ? 'dizzy' : (winner === 'O' ? 'happy' : 'shrug')) : (active('inking') ? 'determined' : ((active('thinking') || active('reaching')) ? 'thinking' : (level === 1 ? 'sleepy' : (level === 3 ? 'determined' : 'idle'))))"
  },
  "controls": {
    "cells": {
      "kind": "choice",
      "value": "cell",
      "event": "picked",
      "enabled": "active('your-turn')",
      "label": "{{ words.board }}",
      "options": {
        "c0": {
          "target": "cell-0",
          "value": "0",
          "keys": [
            "Digit1"
          ],
          "label": "{{ words.cell }} 1, {{ at(board, 0, '') === 'X' ? words.markX : (at(board, 0, '') === 'O' ? words.markO : words.markEmpty) }}"
        },
        "c1": {
          "target": "cell-1",
          "value": "1",
          "keys": [
            "Digit2"
          ],
          "label": "{{ words.cell }} 2, {{ at(board, 1, '') === 'X' ? words.markX : (at(board, 1, '') === 'O' ? words.markO : words.markEmpty) }}"
        },
        "c2": {
          "target": "cell-2",
          "value": "2",
          "keys": [
            "Digit3"
          ],
          "label": "{{ words.cell }} 3, {{ at(board, 2, '') === 'X' ? words.markX : (at(board, 2, '') === 'O' ? words.markO : words.markEmpty) }}"
        },
        "c3": {
          "target": "cell-3",
          "value": "3",
          "keys": [
            "Digit4"
          ],
          "label": "{{ words.cell }} 4, {{ at(board, 3, '') === 'X' ? words.markX : (at(board, 3, '') === 'O' ? words.markO : words.markEmpty) }}"
        },
        "c4": {
          "target": "cell-4",
          "value": "4",
          "keys": [
            "Digit5"
          ],
          "label": "{{ words.cell }} 5, {{ at(board, 4, '') === 'X' ? words.markX : (at(board, 4, '') === 'O' ? words.markO : words.markEmpty) }}"
        },
        "c5": {
          "target": "cell-5",
          "value": "5",
          "keys": [
            "Digit6"
          ],
          "label": "{{ words.cell }} 6, {{ at(board, 5, '') === 'X' ? words.markX : (at(board, 5, '') === 'O' ? words.markO : words.markEmpty) }}"
        },
        "c6": {
          "target": "cell-6",
          "value": "6",
          "keys": [
            "Digit7"
          ],
          "label": "{{ words.cell }} 7, {{ at(board, 6, '') === 'X' ? words.markX : (at(board, 6, '') === 'O' ? words.markO : words.markEmpty) }}"
        },
        "c7": {
          "target": "cell-7",
          "value": "7",
          "keys": [
            "Digit8"
          ],
          "label": "{{ words.cell }} 8, {{ at(board, 7, '') === 'X' ? words.markX : (at(board, 7, '') === 'O' ? words.markO : words.markEmpty) }}"
        },
        "c8": {
          "target": "cell-8",
          "value": "8",
          "keys": [
            "Digit9"
          ],
          "label": "{{ words.cell }} 9, {{ at(board, 8, '') === 'X' ? words.markX : (at(board, 8, '') === 'O' ? words.markO : words.markEmpty) }}"
        }
      }
    },
    "again": {
      "kind": "button",
      "target": "again",
      "event": "again",
      "enabled": "active('your-turn') || active('over')",
      "label": "{{ words.newGame }}"
    },
    "change-level": {
      "kind": "button",
      "target": "change-level",
      "event": "changeLevel",
      "enabled": "active('your-turn') || active('over')",
      "label": "{{ words.changeLevel }}"
    }
  },
  "on": {
    "example.glow:faded": [
      {
        "id": "cheer",
        "actions": [
          {
            "id": "cheered",
            "set": "cheered",
            "to": "true"
          }
        ]
      }
    ]
  },
  "entry": [
    {
      "id": "draw-grid",
      "play": "grid-in"
    },
    {
      "id": "bulb-on",
      "play": "bulb"
    },
    {
      "id": "breathe-on",
      "play": "breathe"
    },
    {
      "id": "blink-on",
      "play": "blink"
    },
    {
      "id": "sway-on",
      "play": "sway"
    },
    {
      "id": "dots-on",
      "play": "dots"
    },
    {
      "id": "twinkle-on",
      "play": "twinkle"
    }
  ],
  "machines": [
    {
      "id": "round",
      "initial": "your-turn",
      "states": {
        "your-turn": {
          "on": {
            "picked": [
              {
                "id": "cell-taken",
                "guard": "at(board, cell, '') !== ''",
                "actions": [
                  {
                    "id": "shake",
                    "play": "nope"
                  },
                  {
                    "id": "buzz",
                    "play": "'nope'", "as": "sound",
                    "group": "sounds"
                  }
                ]
              },
              {
                "id": "place-x",
                "actions": [
                  {
                    "id": "turn",
                    "call": "example.noughts.turn",
                    "with": {
                      "board": "board",
                      "cell": "cell",
                      "level": "level"
                    },
                    "to": {
                      "board": "board",
                      "winner": "winner",
                      "reply": "reply"
                    }
                  },
                  {
                    "id": "new-seed",
                    "set": "seed",
                    "to": "(seed * 7 + 3) % 100000"
                  },
                  {
                    "id": "scratch-x",
                    "play": "'inkX'", "as": "sound",
                    "group": "sounds"
                  },
                  {
                    "id": "moved",
                    "emit": "moved"
                  }
                ]
              }
            ],
            "moved": [
              {
                "id": "bolt-replies",
                "guard": "reply >= 0",
                "target": "thinking"
              },
              {
                "id": "game-ends",
                "target": "over"
              }
            ],
            "again": [
              {
                "id": "rub-out",
                "target": "erasing"
              }
            ]
          }
        },
        "thinking": {
          "entry": [
            {
              "id": "hum-hm",
              "play": "'hum'", "as": "sound",
              "group": "sounds"
            }
          ],
          "after": [
            {
              "id": "bolt-decides",
              "delayMs": "random(550, 1150, seed)",
              "target": "reaching"
            }
          ]
        },
        "reaching": {
          "after": [
            {
              "id": "arm-arrives",
              "delayMs": 660,
              "target": "inking"
            }
          ]
        },
        "inking": {
          "entry": [
            {
              "id": "scratch-o",
              "play": "'inkO'", "as": "sound",
              "group": "sounds"
            }
          ],
          "after": [
            {
              "id": "o-done-over",
              "delayMs": 560,
              "guard": "winner !== ''",
              "target": "over"
            },
            {
              "id": "o-done-play-on",
              "delayMs": 560,
              "guard": "winner === ''",
              "target": "your-turn"
            }
          ]
        },
        "over": {
          "entry": [
            {
              "id": "you-won",
              "if": "winner === 'X'",
              "then": [
                {
                  "id": "count-win",
                  "set": "wins",
                  "to": "min(99, wins + 1)"
                },
                {
                  "id": "pop-wins",
                  "play": "pop-you"
                },
                {
                  "id": "win-chime",
                  "play": "'win'", "as": "sound",
                  "group": "sounds"
                },
                {
                  "id": "dizzy-bolt",
                  "play": "dizzy"
                },
                {
                  "id": "glow",
                  "call": "example.glow.pulse",
                  "with": {
                    "times": "3"
                  }
                }
              ]
            },
            {
              "id": "bolt-won",
              "if": "winner === 'O'",
              "then": [
                {
                  "id": "count-loss",
                  "set": "losses",
                  "to": "min(99, losses + 1)"
                },
                {
                  "id": "pop-losses",
                  "play": "pop-bolt"
                },
                {
                  "id": "lose-note",
                  "play": "'lose'", "as": "sound",
                  "group": "sounds"
                },
                {
                  "id": "bolt-dances",
                  "play": "dance"
                }
              ]
            },
            {
              "id": "nobody-won",
              "if": "winner === 'draw'",
              "then": [
                {
                  "id": "count-draw",
                  "set": "draws",
                  "to": "min(99, draws + 1)"
                },
                {
                  "id": "pop-draws",
                  "play": "pop-draw"
                },
                {
                  "id": "even-note",
                  "play": "'even'", "as": "sound",
                  "group": "sounds"
                },
                {
                  "id": "bolt-shrugs",
                  "play": "shrug"
                }
              ]
            }
          ],
          "on": {
            "again": [
              {
                "id": "rub-out-again",
                "target": "erasing"
              }
            ]
          }
        },
        "erasing": {
          "entry": [
            {
              "id": "sweep-starts",
              "play": "sweep"
            },
            {
              "id": "sweep-sound",
              "play": "'sweep'", "as": "sound",
              "group": "sounds"
            }
          ],
          "after": [
            {
              "id": "paper-clean",
              "delayMs": 1100,
              "target": "your-turn",
              "actions": [
                {
                  "id": "clear",
                  "set": "board",
                  "to": "['', '', '', '', '', '', '', '', '']"
                },
                {
                  "id": "no-winner",
                  "set": "winner",
                  "to": "''"
                },
                {
                  "id": "no-reply",
                  "set": "reply",
                  "to": "-1"
                },
                {
                  "id": "no-cheer",
                  "set": "cheered",
                  "to": "false"
                }
              ]
            }
          ]
        }
      }
    }
  ],
